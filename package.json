{
  "name": "sauvetagesportif",
  "version": "0.3.53",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "^5.0.8",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "dev:meet": "npm run dev -w @meetmgr/meet-app",
