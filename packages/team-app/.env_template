# Meet Manager App — Environment Variables
# Copy to .env and fill in your values

# Admin PIN (used to log in as admin)
ADMIN_PIN=314159

# Resend (email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# Public URL of the frontend (used in email links)
APP_BASE_URL=http://localhost:8001

# Secret key for encrypting PINs in one-time links
SECRET_KEY=change-me-to-a-random-string

# Invoice provider: stripe | quickbooks. One provider at a time, never both.
# Unset = stripe when STRIPE_API_KEY is set, otherwise no provider.
INVOICE_PROVIDER=

# Stripe (draft invoice creation) — secret key (sk_test_... or sk_live_...)
STRIPE_API_KEY=

# QuickBooks Online (INVOICE_PROVIDER=quickbooks). Keys come from the Intuit developer
# portal; use the Development keys with QBO_ENVIRONMENT=sandbox. The redirect URI
# must be registered in the Intuit app exactly as written here (default:
# APP_BASE_URL + /api/quickbooks/callback; production needs https).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=
# Invoices are created tax-exempt against one service Item, never emailed from here.
# Item name (must exist in QuickBooks, or set QBO_INCOME_ACCOUNT to have it created):
QBO_ITEM_NAME=Frais d'inscription
QBO_INCOME_ACCOUNT=
# Exact name of the exempt tax code in the company file ('none' = company has no taxes):
QBO_TAX_CODE=Exempt

# Best time expiry window in months (default: 18). Times older than this are
# purged from the DB when an athlete's registration page is loaded.
BEST_TIME_MAX_AGE_MONTHS=18

# Support email shown in footer and invite emails (optional)
SUPPORT_EMAIL=

# Cloudflare Turnstile CAPTCHA (self-invite page)
# Get keys from https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=