{
  "$comment": [
    "Meet editor fields (MEETVALUES keys) <-> where LENEX carries them, the way Splash Team Manager and Meet Manager",
    "exchange them (formats checked against a real Splash export: packages/team-app/tests/fixtures/meet_template.lxf).",
    "Read by both apps for every LXF they write and read: team-app export.py / meet_parser.py (lenex_meet_fields.py)",
    "and meet-app lenex.ts (lenexMeetFields.ts). Change it here, never in code.",
    "fields[]: key = MEETVALUES key, type = its Splash type (S/I/B/D/F),",
    "  el = element under MEET ('' = the MEET element itself; 'FEES/FEE' needs match), attr = LENEX attribute,",
    "  also = extra places written on export and read as a fallback on import,",
    "  values = {MEETVALUES value: LENEX value} for enums, importAliases = more LENEX values for one MEETVALUES value,",
    "  date = D type stored as YYYYMMDD000000000 <-> LENEX YYYY-MM-DD, cents = F (dollars) <-> LENEX integer cents.",
    "dotfileKeys: Meet Manager settings LENEX has no place for (Splash never transfers them). They travel in the",
    "  hidden .meetvalues zip entry ({KEY: 'TYPE;value'}) so a meet set up in either app keeps them. Splash ignores it.",
    "AGEDATE is not listed: both apps read and write it as the LENEX <AGEDATE> element with their own logic."
  ],
  "fields": [
    { "key": "NAME", "type": "S", "el": "", "attr": "name" },
    { "key": "NAMEEN", "type": "S", "el": "", "attr": "name.en" },
    { "key": "MEETNUMBER", "type": "I", "el": "", "attr": "number" },
    { "key": "MEETTYPE", "type": "S", "el": "", "attr": "type" },
    { "key": "MASTERS", "type": "B", "el": "", "attr": "masters" },
    { "key": "CITY", "type": "S", "el": "", "attr": "city", "also": [{ "el": "FACILITY", "attr": "city" }] },
    { "key": "CITYEN", "type": "S", "el": "", "attr": "city.en" },
    { "key": "STATE", "type": "S", "el": "", "attr": "state", "also": [{ "el": "FACILITY", "attr": "state" }] },
    { "key": "NATION", "type": "S", "el": "", "attr": "nation", "also": [{ "el": "FACILITY", "attr": "nation" }] },
    { "key": "COURSE", "type": "I", "el": "", "attr": "course", "values": { "1": "LCM", "2": "SCY", "3": "SCM" } },
    { "key": "DEADLINE", "type": "D", "el": "", "attr": "deadline", "date": true },
    { "key": "RESERVECOUNT", "type": "I", "el": "", "attr": "reservecount" },
    { "key": "STARTMETHOD", "type": "S", "el": "", "attr": "startmethod" },
    { "key": "TIMING", "type": "I", "el": "", "attr": "timing",
      "values": { "0": "MANUAL3", "1": "SEMIAUTOMATIC", "2": "AUTOMATIC" },
      "importAliases": { "MANUAL1": "0", "MANUAL2": "0" } },
    { "key": "TOUCHPADMODE", "type": "I", "el": "", "attr": "touchpad",
      "values": { "0": "NONE", "1": "ONESIDE", "2": "BOTHSIDE" } },
    { "key": "ORGANIZER", "type": "S", "el": "", "attr": "organizer" },
    { "key": "ORGANIZERURL", "type": "S", "el": "", "attr": "organizer.url" },
    { "key": "HOSTCLUB", "type": "S", "el": "", "attr": "hostclub" },
    { "key": "RESULTURL", "type": "S", "el": "", "attr": "result.url" },
    { "key": "LANEMIN", "type": "I", "el": "POOL", "attr": "lanemin" },
    { "key": "LANEMAX", "type": "I", "el": "POOL", "attr": "lanemax" },
    { "key": "FACILITYNAME", "type": "S", "el": "FACILITY", "attr": "name", "also": [{ "el": "POOL", "attr": "name" }] },
    { "key": "FACILITYSTREET", "type": "S", "el": "FACILITY", "attr": "street" },
    { "key": "QUALIFROM", "type": "S", "el": "QUALIFY", "attr": "from" },
    { "key": "QUALITO", "type": "S", "el": "QUALIFY", "attr": "until" },
    { "key": "CONTACTNAME", "type": "S", "el": "CONTACT", "attr": "name" },
    { "key": "CONTACTEMAIL", "type": "S", "el": "CONTACT", "attr": "email" },
    { "key": "CONTACTINTERNET", "type": "S", "el": "CONTACT", "attr": "internet" },
    { "key": "FEECLUB", "type": "F", "el": "FEES/FEE", "match": { "type": "CLUB" }, "attr": "value", "cents": true },
    { "key": "FEEPERSON", "type": "F", "el": "FEES/FEE", "match": { "type": "ATHLETE" }, "attr": "value", "cents": true },
    { "key": "FEERELAY", "type": "F", "el": "FEES/FEE", "match": { "type": "RELAY" }, "attr": "value", "cents": true },
    { "key": "FEELATEINDIVIDUAL", "type": "F", "el": "FEES/FEE", "match": { "type": "LATEENTRY.INDIVIDUAL" }, "attr": "value", "cents": true },
    { "key": "FEELATERELAY", "type": "F", "el": "FEES/FEE", "match": { "type": "LATEENTRY.RELAY" }, "attr": "value", "cents": true }
  ],
  "dotfileKeys": [
    "SEEDMETHOD", "FASTHEATCOUNT", "SEEDBONUSLAST", "SEEDEXHLAST", "SEEDLATELAST", "COMBINEAGEGROUPS",
    "MINPERHEAT", "LANESORDER", "QUALICOURSE", "ROUNDTOTENTHS", "AGECALCTYPE", "AGEDISPLAY", "NAMEOPTIONS"
  ]
}
